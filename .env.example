# Valores públicos del diálogo Connect de Supabase. No incluya claves secretas.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Solo servidor. Use la nueva secret key de Supabase o, como compatibilidad, la service role.
SUPABASE_SECRET_KEY=sb_secret_your_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key

# Bootstrap manual e idempotente del administrador y la organización Nexaro.
PLATFORM_ADMIN_EMAIL=admin@example.com

# Proveedores de visibilidad. La aplicación funciona aunque no estén configurados.
OPENAI_API_KEY=
OPENAI_VISIBILITY_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_VISIBILITY_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_VISIBILITY_MODEL=sonar-pro

# Protege /api/visibility/jobs para cron o n8n.
VISIBILITY_JOB_SECRET=

# Integración opcional de Google Search Console (OAuth de solo lectura).
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=https://empresas.nexaro-ia.com/api/visibility/gsc/callback
